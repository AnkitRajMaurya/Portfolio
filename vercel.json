{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "redirects": [
    {
      "source": "/Portfolio",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/Portfolio/(.*)",
      "destination": "/$1",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": true
    }
  ]
}
